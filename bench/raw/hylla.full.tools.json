  {
    "annotations": {},
    "description": "Traverse graph edges with recursion.",
    "inputSchema": {
      "properties": {
        "artifact_ref": {
          "description": "Artifact ref (artifact_id or artifact_id@branch)",
          "type": "string"
        },
        "branch": {
          "description": "Optional branch override for artifact_ref scope",
          "type": "string"
        },
        "depth": {
          "description": "Recurse depth (max guardrail)",
          "type": "number"
        },
        "direction": {
          "description": "inbound|outbound",
          "enum": [
            "inbound",
            "outbound"
          ],
          "type": "string"
        },
        "edge": {
          "description": "Edge to traverse",
          "enum": [
            "contains",
            "code.contains",
            "depends_on",
            "code.depends_on",
            "depends_on_package",
            "code.depends_on_package",
            "defines_value_of",
            "code.defines_value_of"
          ],
          "type": "string"
        },
        "graph_ref": {
          "description": "Graph registry key",
          "type": "string"
        },
        "limit": {
          "description": "Max roots",
          "type": "number"
        },
        "node_id": {
          "description": "Stable node ID",
          "type": "string"
        },
        "snapshot": {
          "description": "Optional ingest snapshot override for historical browsing",
          "type": "number"
        },
        "traversal_scope": {
          "description": "artifact|source|global edge expansion scope",
          "enum": [
            "artifact",
            "source",
            "global"
          ],
          "type": "string"
        }
      },
      "required": [
        "artifact_ref",
        "node_id",
        "edge"
      ],
      "type": "object"
    },
    "name": "hylla.graph.nav"
  },
  {
    "annotations": {},
    "description": "Ingest a source snapshot into one artifact graph (structural or enrichment modes).",
    "inputSchema": {
      "properties": {
        "artifact_id": {
          "description": "Override artifact_id (default: canonical source repo id when available)",
          "type": "string"
        },
        "branch": {
          "description": "Override git branch",
          "type": "string"
        },
        "build_tags": {
          "description": "Additional Go build tags (equivalent to `-tags`)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "commit": {
          "description": "Override git commit hash",
          "type": "string"
        },
        "enrichment_mode": {
          "description": "structural_only|embeddings_only|full_enrichment",
          "enum": [
            "structural_only",
            "embeddings_only",
            "full_enrichment"
          ],
          "type": "string"
        },
        "graph_ref": {
          "description": "Graph registry key",
          "type": "string"
        },
        "interactive": {
          "description": "Return a multi-step prompt when version is unspecified.",
          "type": "boolean"
        },
        "ref": {
          "description": "Git ref to checkout (tag/branch/commit)",
          "type": "string"
        },
        "run_id": {
          "description": "Override ingest run ID",
          "type": "string"
        },
        "source_dir": {
          "description": "Local source path to ingest",
          "type": "string"
        },
        "source_url": {
          "description": "GitHub source URL to ingest (https://github.com/org/repo.git)",
          "type": "string"
        },
        "stream": {
          "description": "Stream progress in the tool response (blocks until completion).",
          "type": "boolean"
        },
        "target_goarch": {
          "description": "Override GOARCH for build-tag evaluation (for example: amd64, arm64)",
          "type": "string"
        },
        "target_goos": {
          "description": "Override GOOS for build-tag evaluation (for example: windows, linux, darwin)",
          "type": "string"
        },
        "version": {
          "description": "Semver tag to checkout (GitHub release/tag)",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "name": "hylla.ingest"
  },
