# Binaries — sand binary built into ~/.local/bin by mage install, not /bin/
/bin/*
!/bin/agent-dispatch.sh
/dist/

# Test and coverage artifacts
coverage.out
coverage.html
*.test
*.prof

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Mage cache
mage_output_file.go

# Codex per-project config (machine-local)
.codex/

# Claude Code per-dev overrides; the shared baseline lives in .claude/settings.json
.claude/settings.local.json
# Ephemeral per-session lock written by Claude Code's scheduled-task /
# ScheduleWakeup mechanism. Session-PID-bound; never commit.
.claude/scheduled_tasks.lock

# Sand per-dispatch logs (when sand is running and writing here, optional ignore)
.sand/log/

# Gate hook transients — compiled python cache + gate debug log; never commit.
.claude/hooks/__pycache__/
.claude/hooks/*.log

# Per-dispatch audit trace capture (bin/agent-dispatch.sh writes here; transient).
.claude/agent-runs/
